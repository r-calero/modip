<% content_for :title, "Pose of CID #{@compound.cid}" %>
<div class="row-fluid">
  <h3>CID <%= link_to @compound.cid, compound_path(@compound) %>
    <small><%= @receptor.receptor_type.name %> &middot; target <%= link_to @receptor.target.name, target_path(@receptor.target) %></small></h3>
</div>
<div class="row-fluid">
  <div class="span8">
    <div id="pose-viewer" style="width: 100%; height: 480px; position: relative; border: 1px solid #ddd;" aria-label="3D view of the docking pose"></div>
    <p class="muted" style="margin-top: 5px;">Drag to rotate, scroll to zoom. Receptor as cartoon, residues within 5 &Aring; as lines, ligand as sticks.</p>
  </div>
  <div class="span4">
    <%= structure_image(@compound.cid, 180) %>
    <h4>Poses (AutoDock Vina)</h4>
    <table class="table table-condensed" id="pose-models">
      <thead><tr><th>Model</th><th>Affinity (kcal/mol)</th></tr></thead>
      <tbody>
        <% @models.each_with_index do |value, i| %>
          <tr data-model="<%= i %>" class="<%= 'info' if i == 0 %>" style="cursor: pointer;"><td><%= i + 1 %></td><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
    <%= form_tag(download_conformer_user_path(@receptor.target_id, @compound.cid, @receptor.receptor_type_id)) do %>
      <%= hidden_field_tag 'resource', @pose.path %>
      <%= submit_tag 'Download pose (.pdbqt)', :class => 'btn btn-small btn-primary' %>
    <% end %>
  </div>
</div>

<script src="/javascripts/vendor/3Dmol-2.0.4.min.js"></script>
<script type="text/javascript">
  $(function () {
    var viewer = $3Dmol.createViewer(document.getElementById("pose-viewer"), { backgroundColor: "white" });
    var models = [], receptorModel = null;

    // Vina writes every pose as MODEL ... ENDMDL in the same file.
    function splitModels(text) {
      var parts = text.split(/^ENDMDL\s*$/m), out = [];
      $.each(parts, function (i, p) { if (/^(ATOM|HETATM)/m.test(p)) { out.push(p.replace(/^MODEL.*$/m, "")); } });
      return out.length ? out : [text];
    }

    function show(index) {
      $.each(models, function (i, m) { viewer.removeModel(m); });
      models = [viewer.addModel(splitModels(window.poseText)[index], "pdbqt")];
      models[0].setStyle({}, { stick: { radius: 0.2, colorscheme: "greenCarbon" } });
      receptorModel.setStyle({}, { cartoon: { color: "spectrum", opacity: 0.85 } });
      receptorModel.setStyle({ within: { distance: 5, sel: { model: models[0] } } }, { cartoon: { color: "spectrum", opacity: 0.85 }, line: {} });
      viewer.zoomTo({ model: models[0] });
      viewer.zoom(0.6);
      viewer.render();
      $("#pose-models tr").removeClass("info");
      $("#pose-models tr[data-model='" + index + "']").addClass("info");
    }

    $.getJSON("<%= data_poses_path(:path => @pose.path) %>").done(function (data) {
      window.poseText = data.pose;
      receptorModel = viewer.addModel(data.receptor, "pdbqt");
      show(0);
    }).fail(function () {
      $("#pose-viewer").html("<p class='text-error' style='padding: 20px;'>The pose files could not be loaded.</p>");
    });

    $("#pose-models").on("click", "tr[data-model]", function () { show(parseInt($(this).attr("data-model"), 10)); });
  });
</script>
