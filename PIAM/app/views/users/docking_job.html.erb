<% content_for :title, "Docking job ##{@job.id}" %>
<div class="row-fluid">
  <h3>Docking job #<%= @job.id %> <small><%= @job.target ? @job.target.name : '' %></small>
    <span id="job-status"><%= docking_status_label(@job.status) %></span></h3>
</div>

<div class="row-fluid">
  <div class="span8">
    <div class="progress <%= docking_bar_class(@job) %>" id="job-progress">
      <div class="bar" id="job-progress-bar" style="width: <%= @job.percent %>%;"></div>
    </div>
  </div>
  <div class="span4">
    <strong id="job-percent"><%= @job.percent %>%</strong> &middot;
    <span id="job-processed"><%= @job.processed_compounds %></span> / <span id="job-total"><%= @job.total_compounds %></span> compounds
    <span id="job-failed"><%= docking_counts_note(@job) %></span>
  </div>
</div>

<div class="row-fluid">
  <p>
    <span id="job-waiting"><%= "Waiting for #{pluralize(@job.pending_conversions, '3D conversion')} of its compounds; compounds left in 2D are not docked." if @job.status == 'waiting' %></span>
    <span id="job-current"><%= "Docking compound #{@job.current_cid}..." if @job.current_cid %></span>
    <span id="job-message"><%= @job.message %></span>
  </p>
  <p id="job-actions">
    <% if @job.active? %>
      <%= button_to 'Cancel docking', cancel_docking_job_user_path(@user, @job),
                    { :class => 'btn btn-danger', :id => 'job-cancel', :form_class => 'docking-cancel' }.merge(
                    confirm_options('The compounds not docked yet will not be processed.', "Cancel docking job ##{@job.id}?", 'Cancel the job')) %>
    <% end %>
    <% if @job.target %>
      <%= link_to 'Ranking list', compound_rank_user_url(:target => { :target_id => @job.target_id }), :method => :post, :class => 'btn' %>
      <%= link_to 'Download poses (.tar.gz)', poses_target_path(@job.target, :job_id => @job.id), :class => 'btn' %>
    <% end %>
    <%= link_to 'All my jobs', docking_jobs_user_path(@user), :class => 'btn btn-link' %>
  </p>
</div>

<div class="row-fluid">
  <table class="table table-condensed" id="job-log">
    <thead><tr><th style="width: 15%;">CID</th><th style="width: 10%;">Poses</th><th>Result</th></tr></thead>
    <tbody>
      <% @job.docking_job_logs.each do |log| %>
        <tr class="<%= log.success ? '' : 'error' %>">
          <td><%= log.cid %></td><td><%= log.num_modes %></td><td><pre style="margin: 0;"><%= log.message %></pre></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script type="text/javascript">
  // Progress is read from the database every 2 seconds (see UsersController#docking_job).
  $(function () {
    var url = "<%= docking_job_user_path(@user, @job, :format => :json) %>";
    var lastLog = <%= @job.docking_job_logs.last ? @job.docking_job_logs.last.id : 0 %>;
    var labels = <%= raw DockingJobsHelper::STATUS_LABELS.to_json %>;
    var active = <%= @job.active? ? 'true' : 'false' %>;

    // Same rules as DockingJobsHelper#docking_bar_class / #docking_counts_note.
    var BAR_CLASSES = "progress-striped active progress-success progress-warning progress-danger progress-muted";
    function dockingBarClass(job) {
      if (job.status === "finished") { return job.skipped > 0 ? "progress-warning" : "progress-success"; }
      if (job.status === "failed") { return "progress-danger"; }
      if (job.status === "cancelled") { return "progress-muted"; }
      return "progress-striped active";
    }
    function countsNote(job) {
      var parts = [], noPoses = job.failed - job.skipped;
      if (noPoses > 0) { parts.push(noPoses + " without poses"); }
      if (job.skipped > 0) { parts.push(job.skipped + " not docked"); }
      return parts.length ? "(" + parts.join(", ") + ")" : "";
    }

    function cell(text, pre) {
      var td = $("<td></td>");
      if (pre) { td.append($("<pre style='margin: 0;'></pre>").text(text)); } else { td.text(text); }
      return td;
    }

    function update(job) {
      $("#job-progress-bar").css("width", job.percent + "%");
      $("#job-percent").text(job.percent + "%");
      $("#job-processed").text(job.processed);
      $("#job-total").text(job.total);
      $("#job-failed").text(countsNote(job));
      $("#job-waiting").text(job.status === "waiting" ? "Waiting for " + job.pending_conversions + " 3D conversion" + (job.pending_conversions === 1 ? "" : "s") + " of its compounds; compounds left in 2D are not docked." : "");
      $("#job-current").text(job.current_cid ? "Docking compound " + job.current_cid + "..." : "");
      $("#job-message").text(job.message || "");
      $("#job-status .docking-status").text(job.status).attr("class", "label docking-status " + (labels[job.status] || ""));
      $.each(job.logs, function (i, log) {
        var row = $("<tr></tr>").toggleClass("error", !log.success);
        row.append(cell(log.cid)).append(cell(log.num_modes)).append(cell(log.message, true));
        $("#job-log tbody").append(row);
        lastLog = log.id;
      });
      $("#job-progress").removeClass(BAR_CLASSES).addClass(dockingBarClass(job));
      if (job.status !== "waiting" && job.status !== "queued" && job.status !== "running") {
        active = false;
        $("form.docking-cancel").remove();
      }
    }

    function poll() {
      if (!active) { return; }
      $.getJSON(url, { after: lastLog }).done(update).always(function () {
        if (active) { setTimeout(poll, 2000); }
      });
    }
    setTimeout(poll, 2000);
  });
</script>
