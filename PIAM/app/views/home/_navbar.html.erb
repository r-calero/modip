<%# Navigation bar of the stand-alone pages (help, about). Local: active = 'help' | 'about' %>
 <div class="row-fluid">
       <div class="navbar navbar-fixed-top navbar-inverse">
        <div class="navbar-inner">
          <div class="container">
            <a class="btn btn-navbar" data-toggle="collapse" data-target=".nav-collapse">
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </a>
            <!-- Be sure to leave the brand out there if you want it shown -->
            <a class="brand" href="/">MODIP</a>
           <div class="nav-collapse collapse navbar-inverse-collapse">
                        <div class="span3">
                      <ul class="nav">
                              <li><%= link_to "Home", home_path %></li>
                                    <li class="<%= 'active' if active == 'about' %>"><%= link_to "About", about_path %></li>
                                <li class="<%= 'active' if active == 'help' %>"><%= link_to "Help", help_path %></li>
                                </ul>
                        </div>
             <div class="span3">
            <%= form_tag search_compound_path,  :class => "navbar-search pull-right" do %>
                <%= text_field_tag :cid, params[:cid] , :placeholder => "Find Compound by CID", :class => "search-query span12"%>
            <% end %>
             </div>
             <div class="span4">
               <div class="user-info">
                 <% if current_user && current_user.name != User::DefaultUser %>
                     <p class="text-right" style="margin-top: 10px;">Welcome <strong> <%= current_user.name %> </strong>  <%= link_to 'Logout', logout_path, :method => :delete %></p>
                 <% else %>
                     <p class="text-right" style="margin-top: 10px;"> If you are register, please <%= link_to 'Login', login_path %> otherwise <%= link_to 'Register', new_user_path %> </p>
                 <% end %>
               </div>
             </div>
           </div>
          </div>
        </div>
      </div>
      </div>
      <div class="row-fluid">
	<div style="magin-bottom: 120px"><p>&nbsp;</p></div>
      </div>

