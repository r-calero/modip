<% content_for :title, "Login" %>
<div class="piam_form" >
  <%= form_tag '/login', :method => :post, :class => "form-horizontal" do %>
      <fieldset>
      <legend>Login</legend>
       <div style="display: block; width: 50%; margin: 20px auto 20px auto; padding: 10px 0;">

        <div class="control-group">
          <label class="control-label" for="name" >User Name:</label>
          <div class="controls">
            <%= text_field_tag :name, params[:name] , :placeholder => "UserName"%>
          </div>
        </div>
        <div class="control-group">
          <label class="control-label" for="password" >Password:</label>
          <div class="controls">
            <%= password_field_tag :password, nil, :placeholder => "Password" %>
          </div>
        </div>
        <%= render 'shared/form_protection', :captcha => @captcha_required %>
        <div class="control-group">
          <div class="controls">
            <%= submit_tag "Login", :class => 'btn' %>
            <%= link_to 'Forgot your password?', new_password_reset_path, :style => 'margin-left: 15px;' %>
          </div>
        </div>
       </div>
      </fieldset>
  <% end %>
</div>
