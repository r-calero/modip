<ul>
    <% @schedules.each do |schedule| %>
        <li>
          <%= schedule.info %>
          <%= link_to "edit", edit_schedule_path(schedule.id) %>
          <%= link_to "delete", schedule, { :method => :delete }.merge(confirm_options('Delete this schedule?', 'Delete a schedule', 'Delete')) %>
        </li>
    <% end %>
</ul>