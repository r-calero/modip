<% content_for :title, "Administration" %>
<h3>Administration</h3>

<div class="row-fluid">
  <% @counts.each do |label, value| %>
    <div class="span1" style="min-width: 110px; text-align: center;">
      <div style="font-size: 22px; font-weight: bold;"><%= value %></div>
      <div class="muted"><%= label %></div>
    </div>
  <% end %>
</div>
<p class="muted" style="margin-top: 10px;">
  Administrators: <%= User.admin_names.empty? ? 'every registered user (MODIP_ADMIN_USERS is empty)' : User.admin_names.join(', ') %>
</p>
<p id="query-statuses">
  Queries by last run:
  <% Query::RUN_STATUSES.each do |status| %>
    <% next unless @query_statuses[status] %>
    <%= query_status_label(status) %> <%= @query_statuses[status] %>
  <% end %>
</p>

<h4>Docking jobs in progress</h4>
<% if @active_jobs.empty? %>
  <p class="muted">No docking jobs queued or running.</p>
<% else %>
  <table class="table table-condensed">
    <thead><tr><th>#</th><th>User</th><th>Target</th><th>Status</th><th>Progress</th><th></th></tr></thead>
    <tbody>
      <% @active_jobs.each do |job| %>
        <tr>
          <td><%= job.id %></td><td><%= job.user.try(:name) %></td><td><%= job.target.try(:name) %></td>
          <td><%= docking_status_label(job.status) %></td>
          <td><%= job.processed_compounds %> / <%= job.total_compounds %> (<%= job.percent %>%)</td>
          <td><%= button_to 'Cancel', admin_cancel_docking_job_path(job), { :class => 'btn btn-mini btn-danger' }.merge(
                confirm_options("The job of #{job.user.try(:name)} stops after the compound being docked.", "Cancel docking job ##{job.id}?", 'Cancel the job')) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h4>Recent docking jobs</h4>
<table class="table table-condensed">
  <thead><tr><th>#</th><th>User</th><th>Target</th><th>Status</th><th>Compounds</th><th>Finished</th></tr></thead>
  <tbody>
    <% @recent_jobs.each do |job| %>
      <tr>
        <td><%= job.id %></td><td><%= job.user.try(:name) %></td><td><%= job.target.try(:name) %></td>
        <td><%= docking_status_label(job.status) %></td>
        <td><%= job.processed_compounds %> / <%= job.total_compounds %></td>
        <td><%= job.finished_at ? job.finished_at.strftime('%Y-%m-%d %H:%M') : '-' %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h4 id="conversions">3D conversions</h4>
<style>form.conversion-retry-all, form.conversion-backfill { display: inline; }</style>
<p>
  <% %w(queued running done failed timeout).each do |status| %>
    <span class="label <%= {'queued' => 'label-info', 'running' => 'label-warning', 'done' => 'label-success', 'failed' => 'label-important', 'timeout' => 'label-important'}[status] %>"
          id="conversions-<%= status %>"><%= status %>: <%= @conversion_counts[status] || 0 %></span>
  <% end %>
</p>
<% if @conversion_workers.empty? %>
  <p class="muted" id="conversion-workers-empty">No conversion worker contacted the broker in the last day.</p>
<% else %>
  <table class="table table-condensed table-striped" id="conversion-workers">
    <thead><tr><th>Worker</th><th>Machine</th><th>Status</th><th>Converting</th><th>Last contact</th><th>Done (24 h)</th><th>Failed (24 h)</th></tr></thead>
    <tbody>
      <% @conversion_workers.each do |worker| %>
        <tr class="worker-<%= worker.state %>">
          <td><strong><%= worker.cn %></strong></td>
          <td><%= worker.label %></td>
          <td><%= worker_state_label(worker.state) %></td>
          <td><%= worker.current_cid && worker.state == 'converting' ? "CID #{worker.current_cid}" : '-' %></td>
          <td><%= seconds_ago(worker.idle_seconds) %></td>
          <td><%= @worker_results[[worker.name, 'done']] || 0 %></td>
          <td><%= (@worker_results[[worker.name, 'failed']] || 0) + (@worker_results[[worker.name, 'timeout']] || 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
<p>
  <% if @failed_conversions.any? %>
    <%= button_to "Retry all failed (#{ConversionJob.retry_timeout} s each)", admin_retry_conversions_path,
                  { :class => 'btn btn-small', :form_class => 'conversion-retry-all' }.merge(
                  confirm_options("Every failed or timed-out conversion is queued again, with up to #{ConversionJob.retry_timeout} s each.", 'Retry failed conversions', 'Retry all', 'primary')) %>
  <% end %>
  <% if @backfill_candidates > 0 %>
    <%= button_to "Queue #{@backfill_candidates} older 2D compounds", admin_backfill_conversions_path,
                  { :class => 'btn btn-small', :form_class => 'conversion-backfill' }.merge(
                  confirm_options("#{@backfill_candidates} compounds stored in 2D are queued for their 3D conversion.", 'Convert older compounds', 'Queue them', 'primary')) %>
  <% end %>
</p>
<% if @failed_conversions.any? %>
  <table class="table table-condensed" id="failed-conversions">
    <thead><tr><th>CID</th><th>Status</th><th>Attempts</th><th>Worker</th><th>Error</th><th></th></tr></thead>
    <tbody>
      <% @failed_conversions.each do |job| %>
        <tr>
          <td><%= job.compound ? link_to(job.compound.cid, compound_path(job.compound)) : '-' %></td>
          <td><%= job.status %></td><td><%= job.attempts %></td><td><%= job.worker %></td><td><%= job.error %></td>
          <td><%= button_to 'Retry', admin_retry_conversion_path(job), :class => 'btn btn-mini' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h4>Users</h4>
<table class="table table-condensed table-striped">
  <thead><tr><th>Name</th><th>E-mail</th><th>Role</th><th>Queries</th><th>Docking jobs</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.name == User::DefaultUser ? 'shared guest account' : (User.admin?(user) ? 'admin' : 'user') %></td>
        <td><%= @queries[user.id] || 0 %></td>
        <td><%= @jobs[user.id] || 0 %></td>
        <td>
          <% unless user.id == registered_user.id || user.name == User::DefaultUser %>
            <%= button_to 'Delete', admin_destroy_user_path(user), { :method => :delete, :class => 'btn btn-mini btn-danger' }.merge(
                          confirm_options("All the queries and docking jobs of #{user.name} are deleted too.", "Delete user #{user.name}?", 'Delete')) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @users %>
