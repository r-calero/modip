# Settings of a remote conversion worker. The bundle created on the main
# server (certs.sh worker NAME) already contains a filled .env.worker.

# Name of the worker: the CN of certs/worker.crt, listed in
# MODIP_CONVERSION_WORKERS on the main server.
MODIP_WORKER_NAME=lab-02
# Broker of the main server (MODIP_CONVERSION_PUBLIC_HOST:MODIP_CONVERSION_BROKER_PORT).
MODIP_BROKER_URI=drbssl://10.0.0.10:7443
# Optional: threads of each Open Babel conversion (default 4; more does not help).
# MODIP_BABEL_THREADS=4
# Optional: shown next to the worker name in the Admin page (default: container hostname).
# MODIP_WORKER_LABEL=lab-02
