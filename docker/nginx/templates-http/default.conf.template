# Rendered to /etc/nginx/conf.d/default.conf (replaces the image default server).
#
# "Behind Apache" mode: Apache terminates TLS and proxies here over plain HTTP.
# nginx only listens on HTTP and keeps the scheme/host/port sent by Apache
# (X-Forwarded-Proto, Host, X-Forwarded-Port), so Rails builds https:// URLs.

upstream modip_web {
    server web:${MODIP_WEB_PORT};
    keepalive 16;
}

# Scheme seen by the browser: what Apache says, or "http" if nothing is sent.
map $http_x_forwarded_proto $modip_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      http;
}

# Rate limits for POST requests that log in, create accounts or start jobs
# (GET requests are not limited). Requests over the limit get HTTP 429.
map $request_method $modip_post_client {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $modip_post_client zone=modip_auth:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $modip_post_client zone=modip_jobs:10m rate=${NGINX_JOBS_RATE};
limit_req_status 429;

proxy_cache_path /var/cache/nginx/modip_assets levels=1:2 keys_zone=modip_assets:10m max_size=200m inactive=30d use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name ${MODIP_SERVER_NAME};

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # Real client IP: Apache (on the host or a private network) adds it to
    # X-Forwarded-For. Needed for the rate limits and the logs.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $modip_forwarded_proto;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port;

    location /assets/ {
        proxy_pass http://modip_web;
        proxy_cache modip_assets;
        proxy_cache_valid 200 30d;
        expires max;
        add_header Cache-Control public;
    }

    # Health check of nginx itself (used by docker compose).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Starting downloads and dockings.
    location ~ ^/(queries/[0-9]+/start|users/[0-9]+/start_docking)$ {
        limit_req zone=modip_jobs burst=5 nodelay;
        proxy_pass http://modip_web;
    }

    # Login, registration, account changes and password reset.
    location ~ ^/(login|users|password/) {
        limit_req zone=modip_auth burst=5 nodelay;
        proxy_pass http://modip_web;
        proxy_buffering off;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location / {
        proxy_pass http://modip_web;
        # Progress notifications are polled as text/event-stream; do not buffer them.
        proxy_buffering off;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }
}
