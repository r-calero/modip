# Rendered to /etc/nginx/conf.d/default.conf (replaces the image default server).
# MODIP reverse proxy. Variables in ${...} come from .env (see docker-compose.yml);
# nginx variables ($host, ...) are left as they are.

upstream modip_web {
    server web:${MODIP_WEB_PORT};
    keepalive 16;
}

# Rate limits for POST requests that log in, create accounts or start jobs
# (GET requests are not limited). Requests over the limit get HTTP 429.
map $request_method $modip_post_client {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $modip_post_client zone=modip_auth:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $modip_post_client zone=modip_jobs:10m rate=${NGINX_JOBS_RATE};
limit_req_status 429;

# Cache for /assets (precompiled, fingerprinted files).
proxy_cache_path /var/cache/nginx/modip_assets levels=1:2 keys_zone=modip_assets:10m max_size=200m inactive=30d use_temp_path=off;

# HTTP: ACME challenges (e.g. certbot webroot) and redirect to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${MODIP_SERVER_NAME};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host${MODIP_HTTPS_REDIRECT_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${MODIP_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/${SSL_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${SSL_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:modip_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header X-Forwarded-Port $server_port;

    location /assets/ {
        proxy_pass http://modip_web;
        proxy_cache modip_assets;
        proxy_cache_valid 200 30d;
        expires max;
        add_header Cache-Control public;
    }

    # Health check of nginx itself (used by docker compose).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Starting downloads and dockings.
    location ~ ^/(queries/[0-9]+/start|users/[0-9]+/start_docking)$ {
        limit_req zone=modip_jobs burst=5 nodelay;
        proxy_pass http://modip_web;
    }

    # Login, registration, account changes and password reset.
    location ~ ^/(login|users|password/) {
        limit_req zone=modip_auth burst=5 nodelay;
        proxy_pass http://modip_web;
        proxy_buffering off;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location / {
        proxy_pass http://modip_web;
        # Progress notifications are polled as text/event-stream; do not buffer them.
        proxy_buffering off;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }
}
