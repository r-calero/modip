# ============================================================================
# MODIP - Docker Compose deployment settings
# Copy this file to .env and adjust the values.
# ============================================================================

COMPOSE_PROJECT_NAME=modip
MODIP_IMAGE_PREFIX=modip
MODIP_IMAGE_TAG=latest
TZ=UTC

# ---------------------------------------------------------------------------
# Behind-Apache mode (Apache holds the certificates and proxies to nginx)
# ---------------------------------------------------------------------------
# Uncomment so nginx serves plain HTTP only on NGINX_BIND_ADDRESS:NGINX_PROXY_PORT
# (see docker/apache/modip-vhost.conf). In this mode NGINX_HTTP_PORT,
# NGINX_HTTPS_PORT, SSL_* and MODIP_HTTPS_REDIRECT_PORT are not used.
#COMPOSE_FILE=docker-compose.yml:docker-compose.apache.yml
# 127.0.0.1 if Apache runs on the same host; 0.0.0.0 if it runs on another machine.
NGINX_BIND_ADDRESS=127.0.0.1
# Port where Apache reaches nginx (ProxyPass http://127.0.0.1:8484/).
NGINX_PROXY_PORT=8484

# ---------------------------------------------------------------------------
# Public site (nginx + HTTPS)
# ---------------------------------------------------------------------------
# Server name(s), separated by spaces. "_" accepts any name.
MODIP_SERVER_NAME=modip.example.org
NGINX_VERSION=1.27-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Empty if NGINX_HTTPS_PORT is 443; otherwise ":<port>" (e.g. ":8443").
MODIP_HTTPS_REDIRECT_PORT=
# Host folder with the certificate and its key, and their file names.
SSL_CERT_DIR=./docker/nginx/certs
SSL_CERT_FILE=fullchain.pem
SSL_KEY_FILE=privkey.pem
# Folder for ACME challenges (certbot --webroot), served at /.well-known/acme-challenge/
ACME_WEBROOT_DIR=./docker/nginx/acme
# Maximum upload size (receptors, target files).
NGINX_CLIENT_MAX_BODY_SIZE=100m
NGINX_PROXY_READ_TIMEOUT=300s
# Rate limits per client IP for POST requests: login/registration/password
# reset, and starting downloads/dockings (nginx syntax, e.g. 10r/m).
NGINX_AUTH_RATE=10r/m
NGINX_JOBS_RATE=20r/m

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_VERSION=5.7.44
MYSQL_ROOT_PASSWORD=change-me-root
MODIP_DB_NAME=modip
MODIP_DB_USER=modip
MODIP_DB_PASSWORD=change-me
MODIP_DB_POOL=20
# Schema loaded on first start (empty data volume).
MODIP_DB_SCHEMA_FILE=./database_schema-2015-6-10.sql
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
# Port published on the host's 127.0.0.1 only, for administration.
MYSQL_HOST_PORT=3306

# ---------------------------------------------------------------------------
# Web application (PIAM, Rails 3.2.8 + Puma 1.6.3)
# ---------------------------------------------------------------------------
# Generate one with: openssl rand -hex 64
MODIP_SECRET_TOKEN=change-me
# Anonymous visitors: "readonly" (browse public results only) or "full"
# (they work as the shared default account "test", as in older versions).
MODIP_GUEST_MODE=readonly
# Comma-separated user names allowed to manage targets, receptors, receptor
# types and cycles. Empty = every registered user (old behaviour).
MODIP_ADMIN_USERS=
# Cloudflare Turnstile captcha (https://dash.cloudflare.com -> Turnstile).
# Without both keys the captcha is disabled.
MODIP_CAPTCHA_SITE_KEY=
MODIP_CAPTCHA_SECRET=
# true: accounts are created only after confirming the e-mail link (needs SMTP).
MODIP_REQUIRE_EMAIL_CONFIRMATION=false
MODIP_PASSWORD_MIN_LENGTH=12
# HTTPS-only app and secure cookies. false only for local tests without TLS.
MODIP_FORCE_SSL=true
MODIP_WEB_PORT=3000
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=16

# ---------------------------------------------------------------------------
# dRuby services (internal ports on the "modip" network)
# ---------------------------------------------------------------------------
MODIP_DATABASE_DRB_PORT=9001
MODIP_DOWNLOAD_DRB_PORT=1989
MODIP_DOCKING_DRB_PORT=1997
# Port where the web app receives download/docking notifications (observers).
MODIP_WEB_DRB_PORT=9100
# Networks allowed to connect to the DRb servers (space separated). Empty = private ranges.
MODIP_DRB_ALLOW=

# ---------------------------------------------------------------------------
# PubChem downloads (DownloadEngine 2.x, PUG REST)
# ---------------------------------------------------------------------------
# Child processes of the download server (0 = threads in a single process).
MODIP_DOWNLOAD_PROCESSES=0
# Assays downloaded in parallel by each download (PubChem allows 5 requests/s
# per IP, shared by all of them).
MODIP_DOWNLOAD_THREADS=2
# Open Babel 2D->3D conversions run at the same time. Keep 1: Open Babel
# already uses several cores and parallel conversions slow each other down.
MODIP_BABEL_PROCESSES=1
# Seconds allowed for one 2D->3D conversion (some molecules never finish);
# after that the compound stays in 2D.
MODIP_BABEL_TIMEOUT=300
# Optional HTTP proxy: http://user:password@host:port
MODIP_PROXY=
# E-mail sent to NCBI E-utilities (required by the entrez gem).
ENTREZ_EMAIL=modipserver@gmail.com
# false only if PubChem's certificate cannot be verified.
DOWNLOAD_ENGINE_SSL_VERIFY=true

# ---------------------------------------------------------------------------
# 2D->3D conversions (Open Babel) and conversion workers
# ---------------------------------------------------------------------------
# queue:  compounds without a 3D conformer are stored in 2D and converted by
#         the conversion workers; docking waits for them (default).
# inline: the download server converts them itself (slow downloads).
MODIP_CONVERSION_MODE=queue
# Workers of the main stack ("converter" service): one conversion at a time
# each. About one per 4 cores left free by docking.
MODIP_CONVERSION_LOCAL_WORKERS=1
# Workers allowed to connect (comma separated certificate names). "local" is
# the worker of this stack; add the name of each remote worker
# (docker compose run --rm -T certs worker NAME > NAME.tar.gz). Removing a
# name revokes that worker.
MODIP_CONVERSION_WORKERS=local
# Broker port for remote workers, and the host address it is published on.
# 127.0.0.1 = local workers only; use the private-network address of this
# server to accept remote workers (and allow the port only from them).
MODIP_CONVERSION_BROKER_PORT=7443
MODIP_CONVERSION_BIND=127.0.0.1
# Address remote workers use to reach the broker (written into their bundle)
# and extra names/IPs for the broker certificate (comma separated). After
# changing the hosts: docker compose run --rm certs renew-broker
MODIP_CONVERSION_PUBLIC_HOST=
MODIP_CONVERSION_BROKER_HOSTS=
# Networks allowed to connect to the broker (space separated). Empty = private ranges.
MODIP_CONVERSION_ALLOW=
# Seconds without heartbeat before a conversion goes back to the queue
# (it fails after the second time).
MODIP_CONVERSION_LEASE=120
# Seconds allowed when an administrator retries failed conversions.
MODIP_BABEL_RETRY_TIMEOUT=900
# Threads of each Open Babel conversion. More than 4 does not make it faster,
# and one per core makes it crawl when docking runs on the same machine.
MODIP_BABEL_THREADS=4

# ---------------------------------------------------------------------------
# Outgoing mail (docking notifications)
# ---------------------------------------------------------------------------
MODIP_SMTP_ADDRESS=smtp.gmail.com
MODIP_SMTP_PORT=587
MODIP_SMTP_AUTHENTICATION=plain
MODIP_SMTP_USER=someone@gmail.com
# For Gmail this must be an App Password (16 characters), not the account password.
MODIP_SMTP_PASSWORD=secret
# Sender address (defaults to MODIP_SMTP_USER).
MODIP_SMTP_FROM=
MODIP_SMTP_STARTTLS=true
